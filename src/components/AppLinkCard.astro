---
interface Props {
  title: string;
  subtitle: string;
  icon: string;
  href?: string;
  alt?: string;
}

const {
  title,
  subtitle,
  icon,
  href,
  alt = `${title} app icon`,
} = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={["app-link", { "app-link-disabled": !href }]}
  aria-disabled={href ? undefined : "true"}
>

    <img
        src={icon}
        alt={alt}
        width="56"
        height="56"
    />

    <div>

        <strong>{title}</strong>
        <span>{subtitle}</span>

    </div>

</Tag>
